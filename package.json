{
  "name": "@martzmakes/stripe-events",
  "version": "0.1.0",
  "description": "AWS CDK (v2) constructs to fan one Stripe account's events out to many independent projects via Amazon EventBridge, routed by metadata.project — plus a Lambda-side idempotency helper.",
  "keywords": [
    "aws",
    "cdk",
    "stripe",
    "eventbridge",
    "events",
    "serverless",
    "idempotency",
    "webhook"
  ],
  "license": "Apache-2.0",
  "author": "Matt Martz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martzmakes/stripe-events.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime/index.d.ts",
        "default": "./dist/runtime/index.js"
      },
      "require": {
        "types": "./dist/runtime/index.d.cts",
        "default": "./dist/runtime/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "synth:examples": "cdk synth --no-lookups --app \"tsx examples/root-stack/app.ts\" --output cdk.out/root --quiet && cdk synth --no-lookups --app \"tsx examples/consumer/app.ts\" --output cdk.out/consumer --quiet",
    "guard": "node scripts/check-repository.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run guard"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.247.0",
    "constructs": "^10.5.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1172.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.20.5",
    "aws-cdk": "^2.1148.1",
    "aws-cdk-lib": "^2.275.0",
    "aws-sdk-client-mock": "^4.0.0",
    "constructs": "^10.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsup": "^9.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/martzmakes/stripe-events#readme",
  "bugs": {
    "url": "https://github.com/martzmakes/stripe-events/issues"
  }
}
