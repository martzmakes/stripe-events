{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "declaration": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@martzmakes/stripe-events": ["./src/index.ts"],
      "@martzmakes/stripe-events/runtime": ["./src/runtime/index.ts"]
    }
  },
  "include": ["src", "test", "examples", "scripts"],
  "exclude": ["node_modules", "dist", "cdk.out", "**/cdk.out"]
}
